# Public URL of this site (canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend base URL used by the browser (no trailing slash, no /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Optional: backend URL used by the Next.js server (e.g. internal network address)
API_URL=
# Extra image hosts (comma-separated) e.g. your S3 bucket / CDN domain
NEXT_PUBLIC_IMAGE_HOSTS=
