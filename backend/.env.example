NODE_ENV=development
PORT=5000
TRUST_PROXY=1
# Comma-separated allowed origins; first is used for links in notifications
FRONTEND_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/insider_india

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Same value as API_INTERNAL_KEY in the frontend. Lets the website's server-side rendering bypass per-IP rate limits.
INTERNAL_API_KEY=

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# LOG providers print OTPs/messages to the server log. Never enable in production.
ALLOW_LOG_PROVIDERS=true
LOG_LEVEL=debug

# Server-side key (Places API New). Restrict by server IP in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Local disk storage for development (files under LOCAL_STORAGE_DIR, served by the API).
# Set STORAGE_PROVIDER=LOCAL to use it. Refused in production unless ALLOW_LOCAL_STORAGE=true.
API_PUBLIC_URL=http://localhost:5000
LOCAL_STORAGE_DIR=./uploads
ALLOW_LOCAL_STORAGE=

# Initial values only — copied into encrypted DB settings by `npm run seed`.
# After seeding, manage these from Admin > Settings.
# CLOUDINARY | S3 | LOCAL
STORAGE_PROVIDER=CLOUDINARY
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=insider-india

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_CDN_URL=

WHATSAPP_PROVIDER=LOG
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

SMS_PROVIDER=LOG
SMS_API_KEY=
SMS_SENDER_ID=
SMS_OTP_TEMPLATE_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_MOBILE=

# Testing without an SMS/WhatsApp provider: every OTP becomes this code and nothing is sent.
# Leave empty in production (refused there unless ALLOW_FIXED_OTP=true).
OTP_FIXED_CODE=
ALLOW_FIXED_OTP=
